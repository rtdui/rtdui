{
  "name": "@rtdui/monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs-site"
  ],
  "catalog": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.2",
    "clsx": "2.1.1",
    "daisyui": "5.6.5",
    "lucide-react": "1.22.0",
    "@mdx-js/rollup": "3.1.1",
    "@tabler/icons-react": "3.44.0",
    "date-fns": "4.4.0",
    "@date-fns/tz": "1.5.0",
    "@date-fns/utc": "2.1.1",
    "@floating-ui/react": "0.27.19",
    "@floating-ui/react-dom": "2.1.8",
    "ms": "2.1.3",
    "@types/ms": "2.1.0",
    "shiki": "4.3.0",
    "@shikijs/rehype": "4.3.0",
    "@shikijs/transformers": "4.3.0",
    "@shikijs/colorized-brackets": "4.3.0",
    "@shikijs/types": "4.3.0",
    "tailwindcss": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.2",
    "typescript": "6.0.3"
  },
  "version": "6.1.2",
  "description": "rtdui Components Monorepo",
  "type": "module",
  "repository": "https://github.com/rtdui/rtdui.git",
  "author": "fuzhongwei <jackyleefzw@163.com>",
  "license": "MIT",
  "scripts": {
    "docs-site:dev": "npm run docs:docgen && cd docs-site && npm run dev",
    "docs-site:build": "npm run clean:build && bun install && npm run build && npm run docs:docgen && cd docs-site && npm run build",
    "plop": "bun scripts/plop/index.ts",
    "sync-branches": "bun scripts/sync-branches.sh",
    "outdated": "bun outdated -r",
    "update": "bun update -r -i",
    "changelog": "bun scripts/changelog.ts",
    "tailwind:check": "npx @laststance/tailwind-suggest-canonical-classes \"**/*.tsx\" --check",
    "syncpack:check": "npx --package=syncpack -- syncpack-list-mismatches",
    "syncpack:fix": "npx --package=syncpack -- syncpack-fix-mismatches",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "build": "bun scripts/build/index.ts all",
    "clean": "npm run clean:build && npm run clean:docs",
    "clean:build": "npx rimraf --glob ./docs-site/build ./packages/*/{esm,cjs,lib,node_modules} ./packages/*/styles.css ./packages/*/styles.layer.css ./packages/**/*.tsbuildinfo",
    "clean:docs": "npx rimraf --glob ./docs/app/.docgen/*",
    "clean:tsbuildinfo": "npx rimraf --glob ./packages/**/*.tsbuildinfo",
    "clean:node_modules": "npx rimraf --glob ./**/node_modules",
    "clean:types": "npx rimraf --glob ./packages/hooks/**/*.d.ts",
    "test": "bun test",
    "docs:docgen": "bun scripts/docgen/index.ts && bun scripts/codegen/index.ts",
    "release:check": "npm run clean:build && npm run check && bun scripts/release/index.ts",
    "release": "npm run clean:build && bun i && bun scripts/release/index.ts",
    "release:alpha:patch": "npm run release patch --stage alpha --tag next",
    "release:alpha:minor": "npm run release minor --stage alpha --tag next",
    "release:alpha:major": "npm run release major --stage alpha --tag next",
    "release:patch": "npm run release patch",
    "release:minor": "npm run release minor",
    "release:major": "npm run release major"
  },
  "devDependencies": {
    "@mdx-js/rollup": "catalog:",
    "@shikijs/colorized-brackets": "catalog:",
    "@shikijs/rehype": "catalog:",
    "@shikijs/transformers": "catalog:",
    "@shikijs/types": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "^1.3.14",
    "@types/fs-extra": "^11.0.4",
    "@types/katex": "^0.16.8",
    "@types/ms": "catalog:",
    "@types/node": "26.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/signale": "^1.4.7",
    "@types/yargs": "^17.0.35",
    "autoprefixer": "catalog:",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "daisyui": "catalog:",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.6",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.4",
    "react": "catalog:",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "catalog:",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "rolldown": "^1.1.3",
    "signale": "^1.4.0",
    "simple-git": "^3.36.0",
    "tailwindcss": "catalog:",
    "type-fest": "^5.7.0",
    "typescript": "catalog:",
    "version-next": "^1.0.2",
    "yargs": "^18.0.0"
  },
  "overrides": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
